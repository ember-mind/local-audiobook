#!/bin/bash

# -e: un comando che fallisce ferma lo script invece di lasciarlo continuare
# con exit 0. Dove un exit non-zero e' un esito previsto, e' marcato con
# `|| true` o sta nella condizione di un `if`.
set -e
set -u
set -o pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

PANDRATOR_HOME="${PANDRATOR_HOME:-$HOME/src/Pandrator}"
QWEN_HOME="${QWEN_HOME:-$HOME/src/qwen3-tts-official}"

PANDRATOR_PY="$PANDRATOR_HOME/.venv/bin/python"
QWEN_PY="$QWEN_HOME/.venv/bin/python"

QWEN_DIR="$ROOT/qwen"

RUN_DIR="$ROOT/run"
LOG_DIR="$ROOT/logs"

ROOMTONE_CONFIG="$ROOT/config/roomtone.json"
VOICE_CONFIG="$ROOT/config/voice.json"

PANDRATOR_TOKEN="$ROOT/.secrets/pandrator-token"

QWEN_PID="$RUN_DIR/qwen.pid"
SERVER_PID="$RUN_DIR/pandrator-server.pid"
WORKER_PID="$RUN_DIR/pandrator-worker.pid"

QWEN_LOG="$LOG_DIR/qwen.log"
SERVER_LOG="$LOG_DIR/pandrator-server.log"
WORKER_LOG="$LOG_DIR/pandrator-worker.log"

mkdir -p "$RUN_DIR" "$LOG_DIR"


die() {
  echo "✗ $*" >&2
  exit 1
}


pid_alive() {
  [ -f "$1" ] || return 1

  pid="$(cat "$1" 2>/dev/null || true)"

  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}


port_busy() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}


wait_for_url() {
  url="$1"
  attempts="$2"

  i=0
  while [ "$i" -lt "$attempts" ]; do
    if curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi

    sleep 1
    i=$((i + 1))
  done

  return 1
}


check_installation() {
  [ -x "$PANDRATOR_PY" ] ||
    die "Pandrator Python non trovato: $PANDRATOR_PY"

  [ -x "$QWEN_PY" ] ||
    die "Qwen Python non trovato: $QWEN_PY"

  [ -f "$QWEN_DIR/qwen_pandrator_server.py" ] ||
    die "Adapter Qwen non trovato."

  [ -f "$VOICE_CONFIG" ] ||
    die "Configurazione voce non trovata: $VOICE_CONFIG"

  reference="$(voice_reference_path)" ||
    die "Configurazione voce non leggibile: $VOICE_CONFIG"

  [ -f "$reference" ] ||
    die "Reference voice non trovata: $reference"

  [ -f "$ROOMTONE_CONFIG" ] ||
    die "Configurazione room tone non trovata."
}


# Path della clip di riferimento realmente caricata dall'adapter,
# risolto dalla stessa config che legge l'adapter.
voice_reference_path() {
  python3 - "$ROOT" "$VOICE_CONFIG" <<'PYVOICE'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
config = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))

reference_dir = Path(config.get("reference_dir", "qwen/reference-bank/harry"))

if not reference_dir.is_absolute():
    reference_dir = root / reference_dir

print(reference_dir / config.get("reference_audio", "reference_it_v2.wav"))
PYVOICE
}


start_qwen() {
  if pid_alive "$QWEN_PID"; then
    echo "✓ Qwen è già avviato"
    return
  fi

  rm -f "$QWEN_PID"

  if port_busy 8042; then
    die "La porta 8042 è già occupata da un processo non gestito da audiobook."
  fi

  echo "→ Avvio Qwen3-TTS..."

  (
    cd "$QWEN_DIR" || exit 1

    nohup "$QWEN_PY" -m uvicorn \
      qwen_pandrator_server:app \
      --host 127.0.0.1 \
      --port 8042 \
      >"$QWEN_LOG" 2>&1 &

    echo $! > "$QWEN_PID"
  )

  echo "  Caricamento modello..."

  if wait_for_url "http://127.0.0.1:8042/readyz" 180; then
    echo "✓ Qwen pronto"
  else
    echo
    echo "Ultime righe di $QWEN_LOG:"
    tail -n 20 "$QWEN_LOG" 2>/dev/null || true
    die "Qwen non è diventato ready."
  fi
}


start_server() {
  if pid_alive "$SERVER_PID"; then
    echo "✓ Pandrator server è già avviato"
    return
  fi

  rm -f "$SERVER_PID"

  if port_busy 8097; then
    die "La porta 8097 è già occupata da un processo non gestito da audiobook."
  fi

  echo "→ Avvio Pandrator server..."

  (
    cd "$PANDRATOR_HOME" || exit 1

    PANDRATOR_ROOM_TONE_CONFIG="$ROOMTONE_CONFIG" \
    nohup "$PANDRATOR_PY" -m pandrator serve \
      >"$SERVER_LOG" 2>&1 &

    echo $! > "$SERVER_PID"
  )

  i=0
  while [ "$i" -lt 30 ]; do
    if port_busy 8097; then
      echo "✓ Pandrator server pronto"
      return
    fi

    sleep 1
    i=$((i + 1))
  done

  echo
  tail -n 20 "$SERVER_LOG" 2>/dev/null || true
  die "Pandrator server non è partito."
}


start_worker() {
  if pid_alive "$WORKER_PID"; then
    echo "✓ Pandrator worker è già avviato"
    return
  fi

  rm -f "$WORKER_PID"

  echo "→ Avvio Pandrator worker..."

  (
    cd "$PANDRATOR_HOME" || exit 1

    PANDRATOR_ROOM_TONE_CONFIG="$ROOMTONE_CONFIG" \
    nohup "$PANDRATOR_PY" -m pandrator worker \
      >"$WORKER_LOG" 2>&1 &

    echo $! > "$WORKER_PID"
  )

  sleep 2

  if pid_alive "$WORKER_PID"; then
    echo "✓ Pandrator worker pronto"
  else
    echo
    tail -n 20 "$WORKER_LOG" 2>/dev/null || true
    die "Pandrator worker si è fermato durante l'avvio."
  fi
}


stop_pid() {
  name="$1"
  file="$2"

  if ! pid_alive "$file"; then
    rm -f "$file"
    echo "○ $name non era avviato"
    return
  fi

  pid="$(cat "$file")"

  echo "→ Arresto $name..."

  kill "$pid" 2>/dev/null || true

  i=0
  while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
  fi

  rm -f "$file"

  echo "✓ $name fermato"
}


status_line() {
  name="$1"
  pidfile="$2"

  if pid_alive "$pidfile"; then
    echo "✓ $name"
  else
    echo "○ $name"
  fi
}


roomtone() {
  value="${1:-status}"

  python3 - "$ROOMTONE_CONFIG" "$value" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
value = sys.argv[2]

config = json.loads(path.read_text())

if value == "status":
    if config.get("enabled"):
        print(f"Room tone: {config.get('level_dbfs', -58)} dBFS")
    else:
        print("Room tone: OFF")
    raise SystemExit(0)

if value == "off":
    config["enabled"] = False

elif value == "on":
    config["enabled"] = True

else:
    try:
        level = int(value)
    except ValueError:
        raise SystemExit(
            "Usa: audiobook roomtone status|on|off|<dBFS>\n"
            "Esempio: audiobook roomtone -58"
        ) from None

    # Sotto -90 dBFS il room tone e' inudibile, sopra -30 copre la voce.
    if not -90 <= level <= -30:
        raise SystemExit(
            f"Livello fuori scala: {level} dBFS "
            "(ammesso da -90 a -30)"
        )

    config["enabled"] = True
    config["level_dbfs"] = level

path.write_text(json.dumps(config, indent=2) + "\n")

if config.get("enabled"):
    print(f"✓ Room tone: {config['level_dbfs']} dBFS")
else:
    print("✓ Room tone: OFF")
PY
}


show_status() {
  echo
  echo "Local Audiobook"
  echo "───────────────"

  if curl -fsS http://127.0.0.1:8042/readyz >/dev/null 2>&1; then
    echo "✓ Qwen3-TTS       ready"
  elif port_busy 8042; then
    echo "… Qwen3-TTS       loading"
  else
    echo "○ Qwen3-TTS       stopped"
  fi

  if port_busy 8097; then
    echo "✓ Pandrator       http://127.0.0.1:8097"
  else
    echo "○ Pandrator       stopped"
  fi

  if pid_alive "$WORKER_PID"; then
    echo "✓ Worker           running"
  else
    echo "○ Worker           stopped"
  fi

  if roomtone_enabled; then
    printf '✓ '
  else
    printf '○ '
  fi

  roomtone status

  echo
}


roomtone_enabled() {
  python3 - "$ROOMTONE_CONFIG" <<'PYRTE'
import json
import sys
from pathlib import Path

config = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))

raise SystemExit(0 if config.get("enabled") else 1)
PYRTE
}


run_doctor() {
  errors=0

  ok() {
    echo "✓ $*"
  }

  fail() {
    echo "✗ $*"
    errors=$((errors + 1))
  }

  echo
  echo "Local Audiobook Doctor"
  echo "──────────────────────"

  if [ -d "$PANDRATOR_HOME" ]; then
    ok "Pandrator directory"
  else
    fail "Pandrator directory mancante: $PANDRATOR_HOME"
  fi

  if [ -x "$PANDRATOR_PY" ]; then
    version="$("$PANDRATOR_PY" --version 2>&1 || true)"
    ok "Pandrator Python · $version"
  else
    fail "Pandrator virtualenv rotto o mancante"
  fi

  if [ -x "$PANDRATOR_PY" ] &&
     "$PANDRATOR_PY" -c "import pandrator" >/dev/null 2>&1; then
    ok "Pandrator import"
  else
    fail "Pandrator non importabile"
  fi

  if [ -d "$QWEN_HOME" ]; then
    ok "Qwen directory"
  else
    fail "Qwen directory mancante: $QWEN_HOME"
  fi

  if [ -x "$QWEN_PY" ]; then
    version="$("$QWEN_PY" --version 2>&1 || true)"
    ok "Qwen Python · $version"
  else
    fail "Qwen virtualenv rotto o mancante"
  fi

  if [ -x "$QWEN_PY" ] &&
     "$QWEN_PY" -c "import torch, qwen_tts" >/dev/null 2>&1; then
    ok "torch + qwen_tts"
  else
    fail "torch/qwen_tts non importabili"
  fi

  if [ -x "$QWEN_PY" ]; then
    mps="$("$QWEN_PY" - <<'PYQ' 2>/dev/null || true
import torch
print("yes" if torch.backends.mps.is_available() else "no")
PYQ
)"
    if [ "$mps" = "yes" ]; then
      ok "Apple MPS disponibile"
    else
      fail "Apple MPS non disponibile"
    fi
  fi

  if [ -f "$QWEN_DIR/qwen_pandrator_server.py" ]; then
    ok "Qwen Pandrator adapter"
  else
    fail "Adapter Qwen mancante"
  fi

  if [ -f "$VOICE_CONFIG" ] &&
     python3 -m json.tool "$VOICE_CONFIG" >/dev/null 2>&1; then
    ok "Voice config · $(basename "$VOICE_CONFIG")"

    # Il path arriva dalla stessa config che legge l'adapter: se la
    # voce cambia, questo check segue senza modifiche.
    reference="$(voice_reference_path 2>/dev/null || true)"

    if [ -n "$reference" ] && [ -f "$reference" ]; then
      ok "Reference voice · ${reference#$ROOT/}"
    else
      fail "Reference voice mancante: ${reference:-path non risolto}"
    fi

    transcript="${reference%.wav}.txt"

    if [ -n "$reference" ] && [ -s "$transcript" ]; then
      ok "Reference transcript · ${transcript#$ROOT/}"
    else
      fail "Reference transcript mancante o vuoto: ${transcript:-?}"
    fi
  else
    fail "voice.json mancante o non valido: $VOICE_CONFIG"
  fi

  if [ -f "$ROOT/config/roomtone_it.wav" ]; then
    ok "Room tone WAV"
  else
    fail "Room tone WAV mancante"
  fi

  if [ -f "$ROOMTONE_CONFIG" ] &&
     python3 -m json.tool "$ROOMTONE_CONFIG" >/dev/null 2>&1; then
    room="$(
      python3 - "$ROOMTONE_CONFIG" <<'PYR'
import json, sys
c = json.load(open(sys.argv[1]))
if c.get("enabled"):
    print(f"{c.get('level_dbfs', -58)} dBFS")
else:
    print("OFF")
PYR
    )"
    ok "Room tone config · $room"
  else
    fail "roomtone.json mancante o non valido"
  fi

  if grep -q "_room_tone_pcm" \
       "$PANDRATOR_HOME/pandrator/web/audio_assembly.py" 2>/dev/null; then
    ok "Pandrator room-tone patch applicata"
  else
    fail "Pandrator room-tone patch NON applicata"
  fi

  if [ -s "$ROOT/patches/pandrator-roomtone.patch" ]; then
    ok "Patch di backup salvata"
  else
    fail "Patch di backup mancante o vuota"
  fi

  if [ -s "$PANDRATOR_TOKEN" ]; then
    ok "Token Pandrator"
  else
    fail "Token Pandrator mancante o vuoto: $PANDRATOR_TOKEN"
  fi

  if curl -fsS http://127.0.0.1:8042/readyz >/dev/null 2>&1; then
    ok "Qwen service · ready"
  elif port_busy 8042; then
    echo "… Qwen service · porta 8042 attiva ma non ready"
  else
    echo "○ Qwen service · stopped"
  fi

  if port_busy 8097; then
    ok "Pandrator web · porta 8097"
  else
    echo "○ Pandrator web · stopped"
  fi

  # translate lo avvia da se' se manca: stopped non e' un errore.
  if curl -fsS http://127.0.0.1:1234/v1/models >/dev/null 2>&1; then
    ok "LLM traduzione · porta 1234"
  else
    echo "○ LLM traduzione · stopped (translate lo avvia)"
  fi

  echo

  if [ "$errors" -eq 0 ]; then
    echo "✓ Sistema pronto"
    return 0
  fi

  echo "✗ $errors problema/i trovato/i"
  return 1
}


new_book() {
  source="${1:-}"

  if [ -z "$source" ]; then
    die "Uso: ./audiobook new /percorso/libro.pdf"
  fi

  # Risolve il percorso assoluto anche se contiene spazi.
  source="$(
    python3 - "$source" <<'PYNEWPATH'
from pathlib import Path
import sys

p = Path(sys.argv[1]).expanduser()

if not p.is_file():
    raise SystemExit(f"File non trovato: {p}")

print(p.resolve())
PYNEWPATH
  )" || exit 1

  extension="${source##*.}"

  case "$(printf '%s' "$extension" | tr '[:upper:]' '[:lower:]')" in
    pdf|txt|epub)
      ;;
    *)
      die "Formato non supportato: .$extension (usa PDF, EPUB o TXT)"
      ;;
  esac

  result="$(
    python3 - "$ROOT" "$source" <<'PYNEW'
from pathlib import Path
import json
import re
import sys
import unicodedata
from datetime import datetime

root = Path(sys.argv[1])
source = Path(sys.argv[2])

books = root / "books"
books.mkdir(parents=True, exist_ok=True)

title = source.stem.replace("_", " ").replace("-", " ")
title = re.sub(r"\s+", " ", title).strip()

def slugify(value):
    value = unicodedata.normalize("NFKD", value)
    value = value.encode("ascii", "ignore").decode()
    value = value.lower()
    value = re.sub(r"[^a-z0-9]+", "-", value)
    return value.strip("-") or "book"

slug = slugify(title)
book = books / slug

if book.exists():
    print(f"EXISTS:{book}")
    raise SystemExit(0)

(book / "source").mkdir(parents=True)
(book / "text").mkdir()
(book / "assets").mkdir()
(book / "output").mkdir()
(book / "work").mkdir()

original = book / "source" / f"original{source.suffix.lower()}"
original.write_bytes(source.read_bytes())

config = {
    "version": 1,
    "created_at": datetime.now().astimezone().isoformat(timespec="seconds"),
    "slug": slug,
    "title": title,
    "author": "",
    "source": {
        "file": str(original.relative_to(book)),
        "language": "en"
    },
    "translation": {
        "enabled": True,
        "target_language": "it",
        "provider": "llama.cpp",
        "base_url": "http://127.0.0.1:1234/v1",
        "server_model": "google/gemma-4-12B-it-qat-q4_0-gguf:Q4_0",
        "chunk_chars": 3500
    },
    "voice": {
        "engine": "qwen3-tts",
        "language": "Italian",
        "profile": "italiano",
        "reference": "../../qwen/reference_it.wav"
    },
    "audio": {
        "sentence_pause_ms": 250,
        "paragraph_pause_ms": 700,
        "roomtone": True,
        "roomtone_dbfs": -58
    },
    "output": {
        "format": "m4b",
        "bitrate": "192k",
        "language": "it",
        "cover": "assets/cover.jpg"
    }
}

(book / "book.json").write_text(
    json.dumps(config, indent=2, ensure_ascii=False) + "\n"
)

(book / "README.md").write_text(
    f"""# {title}

Local Audiobook book project.

## Source

    {original.name}

## Workflow

    source
      → extract / clean
      → translate to Italian
      → segment narration
      → Qwen3-TTS
      → assemble with room tone
      → M4B

## Files

- `book.json` — configurazione
- `source/` — libro originale
- `text/` — testo estratto e traduzione
- `assets/` — cover e altri asset
- `work/` — file intermedi
- `output/` — audiobook finale
"""
)

print(f"CREATED:{book}")
PYNEW
  )"

  status="${result%%:*}"
  book_path="${result#*:}"

  case "$status" in
    CREATED)
      echo
      echo "✓ Nuovo libro creato"
      ;;
    EXISTS)
      echo
      echo "✓ Progetto già esistente"
      ;;
    *)
      die "Risposta inattesa durante la creazione del libro: $result"
      ;;
  esac

  echo
  echo "  $book_path"
  echo
  echo "Configurazione:"
  echo "  $book_path/book.json"
  echo
  echo "Prossimo step:"
  echo "  ./audiobook info \"$(basename "$book_path")\""
}


book_info() {
  slug="${1:-}"

  if [ -z "$slug" ]; then
    die "Uso: ./audiobook info nome-libro"
  fi

  file="$ROOT/books/$slug/book.json"

  [ -f "$file" ] || die "Libro non trovato: $slug"

  python3 - "$file" <<'PYINFO'
import hashlib
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
config = json.loads(path.read_text(encoding="utf-8"))
book = path.parent

title = config.get("title") or book.name

translation = config.get("translation", {})
source = config.get("source", {})
voice = config.get("voice", {})
audio = config.get("audio", {})
output = config.get("output", {})

print()
print(title)
print("─" * len(title))

print(f"Slug:         {config.get('slug', book.name)}")
print(f"Author:       {config.get('author') or 'non impostato'}")
print(f"Source:       {source.get('file', 'non impostato')}")
print(
    "Language:     "
    f"{source.get('language', '?')} → "
    f"{translation.get('target_language', '?')}"
)

# `new` scrive server_model; `model` resta accettato per le config vecchie.
print(
    "Translator:   "
    + str(
        translation.get("server_model")
        or translation.get("model")
        or "non impostato"
    )
)

print(f"TTS:          {voice.get('engine', 'non impostato')}")
print(f"Voice:        {voice.get('profile', 'non impostato')}")
print(f"Room tone:    {audio.get('roomtone_dbfs', '?')} dBFS (vedi config/roomtone.json)")
print(
    "Output:       "
    f"{str(output.get('format', '?')).upper()} · "
    f"{output.get('bitrate', '?')}"
)
print()

# Gli stadi della pipeline nell'ordine reale, ognuno con l'artefatto che
# ne prova il completamento. Vedi docs/features/text-pipeline.md.
stages = [
    ("extract", book / "text" / "source_raw.txt"),
    ("clean", book / "text" / "source_en.txt"),
    ("translate", book / "text" / "book_it.txt"),
    ("validate", book / "work" / "validation_report.txt"),
    ("narrate", book / "text" / "narration_it.txt"),
    ("language-qc", book / "work" / "language_qc.json"),
    ("resolve-qc", book / "text" / "narration_final_it.txt"),
    ("apply-fixes", book / "text" / "narration_reviewed_it.txt"),
    ("layout", book / "text" / "narration_ready_it.txt"),
    ("prepare-audio", book / "work" / "pandrator" / "session.json"),
]

print("Pipeline:")

# Uno stadio e' stantio quando l'input da cui e' stato prodotto non e' piu'
# quello che c'e' adesso.
#
# Dove lo stadio registra lo sha256 del proprio input — language_qc.json e
# session.json lo fanno — si confrontano i contenuti, e la risposta e' esatta.
# Altrove resta la mtime, che e' grossolana: rifare uno stadio senza cambiare
# nulla sposta la data e fa gridare al lupo. Per questo l'hash vince quando
# c'e', e la mtime segnala solo se l'hash non e' disponibile.

def recorded_hash(path, *keys):
    """Lo sha256 dell'input che uno stadio ha annotato quando e' girato."""

    if not path.is_file():
        return None

    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None

    for key in keys:
        value = data.get(key)

        if isinstance(value, str) and value:
            return value

    return None


def file_hash(path):
    if not path.is_file():
        return None

    digest = hashlib.sha256()

    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)

    return digest.hexdigest()


# stadio → (file che registra l'hash, chiavi, file di cui e' l'hash)
HASH_CHECKS = {
    "language-qc": (
        book / "work" / "language_qc.json",
        ("source_sha256",),
        book / "text" / "narration_it.txt",
    ),
    "prepare-audio": (
        book / "work" / "pandrator" / "session.json",
        ("prepared_sha256", "source_sha256"),
        book / "text" / "narration_ready_it.txt",
    ),
}

previous_label = None
previous_mtime = None
stale = []


def report(label, artifact):
    """Stampa la riga dello stadio e dice se e' stantio."""

    global previous_label, previous_mtime

    if artifact is None or not artifact.exists():
        print(f"  ○ {label}")
        return

    mtime = artifact.stat().st_mtime
    outdated = False

    if label in HASH_CHECKS:
        record, keys, source = HASH_CHECKS[label]
        expected = recorded_hash(record, *keys)
        actual = file_hash(source)

        if expected and actual:
            # Verita' esatta: conta il contenuto, non la data.
            outdated = expected != actual
            reason = f"{source.name} è cambiato"
        elif previous_mtime is not None and mtime < previous_mtime:
            outdated = True
            reason = f"più vecchio di {previous_label}"
    elif previous_mtime is not None and mtime < previous_mtime:
        outdated = True
        reason = f"più vecchio di {previous_label}"

    if outdated:
        print(f"  ⚠ {label} · {reason}")
        stale.append(label)
    else:
        print(f"  ✓ {label}")

    previous_label = label
    previous_mtime = mtime


for label, artifact in stages:
    report(label, artifact)

exports = sorted((book / "output").glob("*.m4b")) if (book / "output").is_dir() else []

report("export", exports[0] if exports else None)

print()

if stale:
    print(
        "⚠ Da rilanciare: "
        + ", ".join(stale)
        + " — l'input non è più quello da cui sono stati prodotti."
    )
    print()

print("Config:")

cover = book / str(output.get("cover") or "assets/cover.jpg")
print(f"  {'✓' if cover.is_file() else '○'} cover · {cover.name}")

narration = config.get("narration", {})
has_markers = bool(
    str(narration.get("start_marker") or "").strip()
    and str(narration.get("end_marker") or "").strip()
)
print(f"  {'✓' if has_markers else '○'} narration.start_marker / end_marker")

if exports:
    print()
    print("Output:")
    for item in exports:
        size = item.stat().st_size / (1024 * 1024)
        print(f"  {item.name} · {size:.1f} MB")

print()
PYINFO
}


list_books() {
  books="$ROOT/books"

  if [ ! -d "$books" ]; then
    echo "Nessun libro."
    return
  fi

  python3 - "$books" <<'PYBOOKS'
from pathlib import Path
import json
import sys

root = Path(sys.argv[1])
items = []

for config in sorted(root.glob("*/book.json")):
    try:
        c = json.loads(config.read_text())
        items.append((
            c.get("slug", config.parent.name),
            c.get("title", config.parent.name)
        ))
    except Exception:
        pass

if not items:
    print("Nessun libro.")
else:
    print()
    print("Audiobooks")
    print("──────────")
    for slug, title in items:
        print(f"{slug:30} {title}")
    print()
PYBOOKS
}



# ── Stadi della pipeline ─────────────────────────────────────────────────
#
# Ogni stadio di testo e' uno script in scripts/ che prende il path di
# book.json. Gli stadi audio prendono lo slug e parlano con l'API di
# Pandrator. Catena completa e ordine: docs/features/.

book_config() {
  slug="${1:-}"
  command="${2:-info}"

  [ -n "$slug" ] ||
    die "Uso: ./audiobook $command nome-libro"

  config="$ROOT/books/$slug/book.json"

  [ -f "$config" ] ||
    die "Libro non trovato: $slug"

  printf '%s' "$config"
}


# run_stage <script> <label> <command> <slug> [args...]
run_stage() {
  script="$1"
  label="$2"
  command="$3"
  slug="${4:-}"

  shift 4 || true

  config="$(book_config "$slug" "$command")"

  echo
  echo "$label · $slug"
  echo "────────────────────────"

  "$PANDRATOR_PY" "$ROOT/scripts/$script" "$config" "$@"
}


extract_book() {
  run_stage extract_book.py "Extract" extract "${1:-}"
}


clean_book() {
  run_stage clean_book.py "Clean" clean "${1:-}"
}


translate_book() {
  slug="${1:-}"
  option="${2:-}"

  if [ "$option" = "--reset" ]; then
    run_stage translate_book.py "Translate" translate "$slug" --reset
  elif [ -n "$option" ]; then
    die "Opzione non riconosciuta: $option (solo --reset)"
  else
    run_stage translate_book.py "Translate" translate "$slug"
  fi
}


validate_translation() {
  run_stage validate_translation.py "Validate" validate "${1:-}"
}


finalize_translation() {
  slug="${1:-}"

  run_stage finalize_translation.py "Finalize" finalize "$slug"

  echo
  echo "→ Validation"

  "$PANDRATOR_PY" \
    "$ROOT/scripts/validate_translation.py" \
    "$(book_config "$slug" finalize)"
}


# Ritaglia il corpo del libro fra narration.start_marker e end_marker.
narrate_book() {
  run_stage build_narration.py "Narrate" narrate "${1:-}"
}


language_qc_book() {
  run_stage language_qc.py "Language QC" language-qc "${1:-}"
}


# Applica solo le correzioni che il QC ha marcato come sicure.
resolve_qc_book() {
  run_stage resolve_language_qc.py "Resolve QC" resolve-qc "${1:-}"
}


# Applica le decisioni umane da work/language_qc_manual_fixes.json.
apply_fixes_book() {
  run_stage apply_review_fixes.py "Apply fixes" apply-fixes "${1:-}"
}


# Residui di impaginazione, in due passate.
layout_book() {
  slug="${1:-}"

  run_stage clean_layout.py "Clean layout" layout "$slug"
  run_stage finalize_layout.py "Finalize layout" layout "$slug"
}


# Cancella da work/ quello che e' sicuro ricostruire. Senza --yes mostra e basta.
prune_work() {
  slug="${1:-}"

  config="$(book_config "$slug" prune)"

  shift 1 || true

  "$PANDRATOR_PY" "$ROOT/scripts/prune_work.py" "$config" "$@"
}


