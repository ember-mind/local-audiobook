ui_line() {
  printf '  %s\n' "$1"
}

ui_step() {
  number="$1"
  label="$2"
  state="${3:-○}"

  printf '\n'
  printf '  %s  %-11s %s\n' "$number" "$label" "$state"
}

ui_compact() {
  PYTHONUNBUFFERED=1 "$@" 2>&1 |
    awk '
      # Intestazione che run_stage stampa: "<Label> · <slug>".
      # Filtro generico: aggiungere uno stadio non richiede
      # di aggiungere una riga qui.
      /^[A-Z][A-Za-z ]* · / { next }
      /^Validation$/ { next }
      /^─+$/ { next }

      /^Output: / {
        sub(/^Output: .*\/books\/[^\/]+\//, "      ↳ ")
      }

      /^Report: / {
        sub(/^Report: .*\/books\/[^\/]+\//, "      ↳ ")
      }

      /^warning: The `fitz` API is deprecated/ {
        next
      }

      {
        if ($0 != "")
          print "      " $0
      }
    '
}



ui_translate() {
  PYTHONUNBUFFERED=1 "$@" 2>&1 |
    python3 -u "$ROOT/scripts/ui_translate_progress.py"

  command_status=${PIPESTATUS[0]}
  return "$command_status"
}







# ui_run_step <numero> <label> <runner> <funzione> <slug>
#
# Stampa lo step, lo esegue attraverso il filtro di output scelto e
# propaga l'exit code invariato: gli stadi usano codici diversi da 1
# per dire cose diverse (2 = serve una revisione umana).
ui_run_step() {
  number="$1"
  label="$2"
  runner="$3"
  target="$4"
  slug="$5"

  ui_step "$number" "$label" "●"

  if "$runner" "$target" "$slug"; then
    printf '  %s  %-11s ✓\n' "$number" "$label"
    return 0
  fi

  status=$?

  printf '  %s  %-11s ✕\n' "$number" "$label"

  return "$status"
}


prepare_book() {
  slug="${1:-}"

  config="$(book_config "$slug" prepare)"
  book="$ROOT/books/$slug"

  header="$(
    python3 - "$config" <<'PYHEADER'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))

print(data.get("title") or data.get("slug") or "Audiobook")
print(
    str(data.get("source", {}).get("language", "en")).upper()
    + " → "
    + str(data.get("translation", {}).get("target_language", "it")).upper()
)
PYHEADER
  )"

  title="$(printf '%s' "$header" | sed -n '1p')"
  languages="$(printf '%s' "$header" | sed -n '2p')"

  printf '\n'
  printf '╭──────────────────────────────────────────────────────────╮\n'
  printf '│  ✦ LOCAL AUDIOBOOK                                      │\n'
  printf '│                                                          │\n'
  printf '│  %-56.56s│\n' "$title"
  printf '│  %-56.56s│\n' "$languages"
  printf '╰──────────────────────────────────────────────────────────╯\n'

  ui_run_step "01" "EXTRACT" ui_compact extract_book "$slug" || return $?
  ui_run_step "02" "CLEAN" ui_compact clean_book "$slug" || return $?
  ui_run_step "03" "TRANSLATE" ui_translate translate_book "$slug" || return $?
  ui_run_step "04" "QC" ui_compact finalize_translation "$slug" || return $?

  # NARRATE ritaglia il corpo del libro. Senza questo stadio PROOFREAD
  # non ha il file su cui lavorare: serve prima dei marcatori in book.json.
  if ! has_narration_markers "$config"; then
    ui_step "05" "NARRATE" "◈"
    printf '\n'
    printf '  ────────────────────────────────────────────────\n'
    printf '  ✦ CONFIGURAZIONE INCOMPLETA\n'
    printf '\n'
    printf '    Servono i marcatori di narrazione in book.json:\n'
    printf '\n'
    printf '      "narration": {\n'
    printf '        "start_marker": "<prima riga da leggere>",\n'
    printf '        "end_marker": "<ultima riga da leggere>"\n'
    printf '      }\n'
    printf '\n'
    printf '    Il testo tradotto da cui prenderli:\n'
    printf '      text/book_it.txt\n'
    printf '\n'
    printf '    Poi → ./audiobook prepare "%s"\n' "$slug"
    printf '\n'
    return 3
  fi

  ui_run_step "05" "NARRATE" ui_compact narrate_book "$slug" || return $?

  ui_step "06" "PROOFREAD" "●"

  if ui_compact language_qc_book "$slug"; then
    printf '  06  %-11s ✓\n' "PROOFREAD"
  else
    status=$?

    if [ "$status" -eq 2 ]; then
      printf '  06  %-11s ◈ review\n' "PROOFREAD"
      printf '\n'
      printf '  ────────────────────────────────────────────────\n'
      printf '  ✦ REVIEW REQUIRED\n'
      printf '\n'
      printf '    work/language_qc.json\n'
      printf '\n'
      printf '    Decisioni manuali (opzionale):\n'
      printf '      work/language_qc_manual_fixes.json\n'
      printf '\n'
      printf '    Poi → ./audiobook finish "%s"\n' "$slug"
      printf '\n'
      return 2
    fi

    printf '  06  %-11s ✕\n' "PROOFREAD"
    return "$status"
  fi

  printf '\n'
  printf '  ────────────────────────────────────────────────\n'
  printf '  ✦ TEXT READY\n'
  printf '\n'
  printf '    text/narration_it.txt\n'
  printf '\n'
  printf '    Next → ./audiobook finish "%s"\n' "$slug"
  printf '\n'
}


has_narration_markers() {
  python3 - "$1" <<'PYMARKERS'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
narration = data.get("narration", {}) or {}

start = str(narration.get("start_marker") or "").strip()
end = str(narration.get("end_marker") or "").strip()

raise SystemExit(0 if start and end else 1)
PYMARKERS
}


# Dopo la revisione: le tre passate meccaniche che portano da
# narration_it.txt a narration_ready_it.txt.
finish_book() {
  slug="${1:-}"

  book_config "$slug" finish >/dev/null

  resolve_qc_book "$slug"
  apply_fixes_book "$slug"
  layout_book "$slug"

  printf '\n'
  printf '  ────────────────────────────────────────────────\n'
  printf '  ✦ NARRATION READY\n'
  printf '\n'
  printf '    text/narration_ready_it.txt\n'
  printf '\n'
  printf '    Next → ./audiobook prepare-audio "%s"\n' "$slug"
  printf '\n'
}


