+_ROOM_TONE_CACHE: dict[tuple[object, ...], bytes] = {}
+
+
+def _room_tone_pcm(writer: wave.Wave_write) -> bytes:
+    import json
+    import math
+    import sys
+    from array import array
+
+    configured = os.environ.get("PANDRATOR_ROOM_TONE_CONFIG")
+    config_path = (
+        Path(configured).expanduser()
+        if configured
+        else Path(__file__).resolve().parents[2] / "roomtone.json"
+    )
+
+    if not config_path.is_file():
+        return b""
+
+    try:
+        config = json.loads(config_path.read_text())
+    except Exception:
+        return b""
+
+    if not bool(config.get("enabled", False)):
+        return b""
+
+    wav_value = str(config.get("wav", "roomtone_it.wav")).strip()
+    wav_path = Path(wav_value).expanduser()
+
+    if not wav_path.is_absolute():
+        wav_path = config_path.parent / wav_path
+
+    if not wav_path.is_file():
+        return b""
+
+    try:
+        source_dbfs = float(config.get("source_dbfs", -58))
+        target_dbfs = float(config.get("level_dbfs", -58))
+    except (TypeError, ValueError):
+        return b""
+
+    target_dbfs = max(-80.0, min(-30.0, target_dbfs))
+
+    rate = int(getattr(writer, "_framerate", 0) or 0)
+    channels = int(getattr(writer, "_nchannels", 0) or 0)
+    width = int(getattr(writer, "_sampwidth", 0) or 0)
+
+    try:
+        key = (
+            str(wav_path),
+            wav_path.stat().st_mtime_ns,
+            config_path.stat().st_mtime_ns,
+            source_dbfs,
+            target_dbfs,
+            rate,
+            channels,
+            width,
+        )
+    except OSError:
+        return b""
+
+    cached = _ROOM_TONE_CACHE.get(key)
+    if cached is not None:
+        return cached
+
+    try:
+        with wave.open(str(wav_path), "rb") as reader:
+            if (
+                reader.getcomptype() != "NONE"
+                or reader.getframerate() != rate
+                or reader.getnchannels() != channels
+                or reader.getsampwidth() != width
+            ):
+                return b""
+
+            pcm = reader.readframes(reader.getnframes())
+
+    except (EOFError, OSError, wave.Error):
+        return b""
+
+    # Il nostro assembler lavora in PCM 16 bit.
+    if width != 2:
+        return b""
+
+    gain = math.pow(10.0, (target_dbfs - source_dbfs) / 20.0)
+
+    if abs(gain - 1.0) > 1e-6:
+        samples = array("h")
+        samples.frombytes(pcm)
+
+        if sys.byteorder != "little":
+            samples.byteswap()
+
+        for i, sample in enumerate(samples):
+            value = round(sample * gain)
+            samples[i] = max(-32768, min(32767, value))
+
+        if sys.byteorder != "little":
+            samples.byteswap()
+
+        pcm = samples.tobytes()
+
+    _ROOM_TONE_CACHE[key] = pcm
+    return pcm
+
